# Python
.venv/
.venvs/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
dist/
build/

# External models (cloned separately via install script)
external/

# Built binaries
.local/

# Search databases (built locally)
data/

# Run outputs
runs/
experiments/runs/
experiments/logs/

# SLURM logs
slurm-*.out
slurm-*.err

# Per-target evaluation work artifacts (regenerated from runs)
experiments/**/_eval_work/
experiments/**/_per_metric_work/
experiments/**/_validate_*.log
experiments/**/_validate_*.json
experiments/**/_supplement_*.log
experiments/**/_cluster_work/

# Auto-generated input YAMLs (built from CSV by batch_prepare_*.sh)
experiments/**/pipeline/

# Heavy eval artifacts (regenerated from runs)
experiments/**/per_pose_scores.csv
experiments/**/evaluation.json
experiments/**/rerun_runs.txt

# Collected/staged poses + final submissions (large, regenerable)
experiments/poses_unified/
experiments/poses_unified_collect.log
experiments/submissions/

# casp16_test bulky archives
experiments/casp16_test/**/*.tgz
experiments/casp16_test/**/*.tar.gz
experiments/casp16_test/**/evaluation.json

# Local backup files from in-place patches
experiments/runs/**/*.bak

# OS
.DS_Store

# Claude Code / OMC
.agents/
.omc/
plugins/
